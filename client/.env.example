# =========================================================
# VIGILANS FRONTEND - ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Supabase (Database & Realtime)
# Go to your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Backend API & WebSocket (Optional if using Supabase directly, or set to your deployed backend URL)
# Example: https://vigilans-server.onrender.com/api
# VITE_API_URL=https://your-backend-api.com/api
# VITE_WS_URL=wss://your-backend-api.com/ws
